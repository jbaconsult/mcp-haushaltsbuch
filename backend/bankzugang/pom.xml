<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.jbaconsult.haushaltsbuch</groupId>
        <artifactId>haushaltsbuch-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bankzugang</artifactId>
    <name>Haushaltsbuch :: Bankzugang</name>
    <description>Adapter zu einem Anbieter von Kontoinformationen</description>

    <!--
      Eigenes Modul, weil der Adapter HTTP braucht und damit weder nach kern noch
      nach persistenz gehoert. kern bleibt frameworkfrei; persistenz spricht mit
      der Datenbank, nicht mit dem Netz.

      Bewusst sparsam: HTTP kommt aus dem JDK, JSON aus Jackson. Ein REST-Client
      mit Schnittstellengenerierung waere bequemer und wuerde die Anbieterbegriffe
      als annotierte Typen ins Projekt tragen - genau das, was der Port verhindern
      soll.
    -->
    <dependencies>
        <dependency>
            <groupId>de.jbaconsult.haushaltsbuch</groupId>
            <artifactId>kern</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
