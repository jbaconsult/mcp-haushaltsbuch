# Vorlage für die lokale Entwicklung. Kopieren nach .env und ausfüllen.
#
#     cp .env.example .env
#
# .env ist per .gitignore ausgeschlossen. Hier stehen ausschliesslich
# Platzhalter — nie echte Geheimnisse, IBANs oder Kontonamen.

# --- Datenbank ------------------------------------------------------------
# Die Anwendung verbindet sich mit dieser Rolle und wechselt pro Transaktion
# per SET LOCAL ROLE in die eingeschränkte Rolle haushaltsbuch_app. Diese wird
# von der Migration V1 angelegt; sie ist weder Eigentümer noch Superuser,
# und genau deshalb greifen die RLS-Policies für sie.
POSTGRES_DB=haushaltsbuch
POSTGRES_USER=haushaltsbuch_eigentuemer
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_PORT=5432

# --- OIDC / Keycloak ------------------------------------------------------
# Produktion:   https://auth.kumbuka.ai/realms/haushaltsbuch
# Entwicklung:  https://auth.jbaconsult.com/realms/haushaltsbuch
# CI:           http://keycloak:8080/realms/haushaltsbuch (docker-compose.ci.yml)
OIDC_AUTH_SERVER_URL=https://auth.jbaconsult.com/realms/haushaltsbuch
OIDC_CLIENT_ID=haushaltsbuch-backend
OIDC_CLIENT_SECRET=bitte-aendern

# Der BFF hält die Sitzung. Der Browser bekommt kein Token zu sehen.
BFF_CLIENT_ID=haushaltsbuch-bff
BFF_CLIENT_SECRET=bitte-aendern
# openssl rand -base64 32
BFF_SESSION_SECRET=bitte-aendern

# --- Bankzugang (Anbieter von Kontoinformationen) --------------------------
# Der Anbieter ist Konfiguration, nicht Abhängigkeit. Jede Installation bringt
# einen eigenen Zugang mit; nichts davon steht im Quelltext oder im Abbild.
#
# Zwei Umgebungen, zwei Registrierungen: Anwendungen lassen sich zwischen
# Sandbox und Produktion nicht umziehen. Die Produktionsanwendung wird eine
# eigene Registrierung mit eigenem Schlüsselpaar und eigener Anwendungs-ID.
#
# Sandbox:    https://api.enablebanking.com  (dieselbe Adresse, andere Anwendung)
BANKZUGANG_BASIS_URL=https://api.enablebanking.com

# Die Anwendungs-ID ist kein Geheimnis - sie ist nur der "kid" im JWT-Kopf. Sie
# steht trotzdem hier und nicht im Code: ein fest verdrahteter Wert wäre ein
# Fehler, der erst beim zweiten Nutzer auffällt.
BANKZUGANG_ANWENDUNGS_ID=bitte-eintragen

# Pfad zur Datei mit dem privaten Schlüssel, AUSSERHALB des Repositoriums.
# Erzeugt wird sie ausserhalb des Browsers, etwa mit:
#
#     openssl genrsa -out ~/.hhb/bankzugang.pem 2048
#     openssl req -new -x509 -key ~/.hhb/bankzugang.pem -out ~/.hhb/bankzugang.crt -days 3650
#
# Erwartet wird PKCS#8 (BEGIN PRIVATE KEY). Ein Schlüssel im Format PKCS#1
# (BEGIN RSA PRIVATE KEY) lässt sich umwandeln:
#
#     openssl pkcs8 -topk8 -nocrypt -in alt.pem -out neu.pem
#
# Niemals ins Repositorium, niemals ins Abbild, niemals als Klartext in einer
# Umgebungsvariablen. *.pem ist in .gitignore - siehe dort.
BANKZUGANG_SCHLUESSEL_DATEI=/absoluter/pfad/zu/bankzugang.pem

# Beim Anbieter sind genau zwei Rückleitungsadressen hinterlegt und damit
# verbindlich. Eine Abweichung lässt den Ablauf abbrechen, ohne dass der Fehler
# auf den Pfad zeigt.
#
#   Zielumgebung: https://hhb.jbaconsult.com/bank/rueckleitung
#   Lokal:        http://localhost:3000/bank/rueckleitung
BANKZUGANG_RUECKLEITUNG=http://localhost:3000/bank/rueckleitung

# Gewünschte Gültigkeit der Autorisierung in Tagen. Wird an der Obergrenze des
# Instituts gekappt.
BANKZUGANG_GUELTIGKEIT_TAGE=180
BANKZUGANG_LAND=DE

# --- Ports ----------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Frontend -------------------------------------------------------------
# Adresse des Backends aus Sicht des BFF, nicht aus Sicht des Browsers.
# Bewusst ohne NEXT_PUBLIC_-Präfix: eine so benannte Variable würde in das
# Browser-Bundle eingebettet und die interne Adresse nach aussen tragen.
BACKEND_BASE_URL=http://backend:8080
