# Vorlage für die lokale Entwicklung. Kopieren nach .env und ausfüllen.
#
#     cp .env.example .env
#
# .env ist per .gitignore ausgeschlossen. Hier stehen ausschliesslich
# Platzhalter — nie echte Geheimnisse, IBANs oder Kontonamen.

# --- Datenbank ------------------------------------------------------------
# Die Anwendung verbindet sich mit dieser Rolle und wechselt pro Transaktion
# per SET LOCAL ROLE in die eingeschränkte Rolle haushaltsbuch_app. Diese wird
# von der Migration V1 angelegt; sie ist weder Eigentümer noch Superuser,
# und genau deshalb greifen die RLS-Policies für sie.
POSTGRES_DB=haushaltsbuch
POSTGRES_USER=haushaltsbuch_eigentuemer
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_PORT=5432

# --- OIDC / Keycloak ------------------------------------------------------
# Produktion:   https://auth.kumbuka.ai/realms/haushaltsbuch
# Entwicklung:  https://auth.jbaconsult.com/realms/haushaltsbuch
# CI:           http://keycloak:8080/realms/haushaltsbuch (docker-compose.ci.yml)
OIDC_AUTH_SERVER_URL=https://auth.jbaconsult.com/realms/haushaltsbuch
OIDC_CLIENT_ID=haushaltsbuch-backend
OIDC_CLIENT_SECRET=bitte-aendern

# Der BFF hält die Sitzung. Der Browser bekommt kein Token zu sehen.
BFF_CLIENT_ID=haushaltsbuch-bff
BFF_CLIENT_SECRET=bitte-aendern
# openssl rand -base64 32
BFF_SESSION_SECRET=bitte-aendern

# --- Ports ----------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Frontend -------------------------------------------------------------
# Adresse des Backends aus Sicht des BFF, nicht aus Sicht des Browsers.
# Bewusst ohne NEXT_PUBLIC_-Präfix: eine so benannte Variable würde in das
# Browser-Bundle eingebettet und die interne Adresse nach aussen tragen.
BACKEND_BASE_URL=http://backend:8080
