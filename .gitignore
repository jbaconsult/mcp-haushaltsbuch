# --- Umgebung und Geheimnisse ---------------------------------------------
# Niemals echte Werte ins Repo. Vorlage ist .env.example.
.env
.env.*
!.env.example
*.pem

# Gerenderte Keycloak-Realms tragen aktive Client-Secrets. Die Vorlage
# realm-haushaltsbuch.json.tmpl gehoert ins Repo, ihr gerendertes Ergebnis
# niemals - siehe infra/keycloak/README-realm.md. Ein einmal committetes Secret
# ist auch nach "git rm" noch in der Historie.
infra/keycloak/realms-rendered/
*.p12
*.jks
*.key
# Der private Schluessel des Bankzugangs. Steht hier, bevor er existiert - eine
# Datei, die erst nach ihrem ersten Commit ausgeschlossen wird, ist in der
# Historie und dort nicht mehr zu entfernen. Der Compose-Vorgabewert zeigt
# hierher, damit ein versehentlich im Projekt abgelegter Schluessel trotzdem
# nicht mitwandert.
.bankzugang-schluessel.pem

# --- Echte Kontodaten -----------------------------------------------------
# Zielbild ist Open Source. Importe und Auszüge bleiben lokal.
/daten/
*.mt940
*.sta
*.camt
*.camt.xml

# Ausnahme: die synthetischen Fixtures der Parser-Tests. Sie tragen dieselben
# Endungen wie echte Auszüge, weil sie dieselben Formate SIND — die Regel oben
# greift also auch auf sie, und zwar lautlos: "git add" überspringt sie, "git
# status" zeigt nur das Verzeichnis, und lokal läuft alles grün, weil die Dateien
# auf der Platte liegen. Erst die CI mit frischem Checkout merkt es.
#
# Die Grenze ist der Pfad. Unterhalb von src/test/resources/ steht ausschließlich
# Erfundenes — siehe CLAUDE.md, Abschnitt "Testdaten". Ein echter Auszug bleibt
# überall sonst ignoriert, auch im Projektwurzelverzeichnis.
!backend/*/src/test/resources/**/*.mt940
!backend/*/src/test/resources/**/*.sta
!backend/*/src/test/resources/**/*.camt
!backend/*/src/test/resources/**/*.camt.xml

# --- Java / Maven ---------------------------------------------------------
target/
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!.mvn/wrapper/*.jar

# --- Node / Next.js -------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.npm/
.pnpm-store/

# --- Werkzeuge ------------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
*.log

sonar.log
